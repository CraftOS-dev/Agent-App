.principal
.superuser

# Agent App runtime artifacts (dev instances, backups, local DBs, adapter state)
# NOTE: .a2app/system-hashes.json (the ownership canon) IS committed, never ignored
*.db
*.sqlite
backups/
.a2app/backups/
.a2app/dev/
apps/erp/
apps/atlas-erp/
apps/expense-tracker/

# the operate client's per-app describe cache: written on any walk, keyed on the
# app's own schemaVersion, and rebuilt on demand. Never a source file.
# `**/` because a pattern with an inner slash is anchored to this file's
# directory, and these land under apps/<app>/.a2app/, not the repo root.
**/.a2app/describe-cache.json
# `agent-app <dir> serve` bookkeeping: the pid/port record `stop` reads, and
# the lock that serializes two concurrent serves. Both are per-machine and
# both are removed on a clean stop.
**/.a2app/serve.json
**/.a2app/serve.lock
# `agent-app <dir> bridge` bookkeeping: the same three, for the app→agent
# service — its pid record, its lock, and the log its detached process writes.
**/.a2app/bridge.json
**/.a2app/bridge.lock
**/.a2app/bridge.log
# A lock broken after its holder died is renamed aside before being deleted
# (that rename is what makes the break atomic). On Windows the delete can lose a
# race with an open handle and leave the copy behind — inert, never read, and
# never something to commit.
**/.a2app/*.lock.breaking.*
**/data/db.json
**/data/a2app-state.json
a2app-state.json

# editors & OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# reference repos & research are working material, not part of this distribution
ref/
research/

# authored specs and agent-guidance files — kept out of the tracked tree per
# project preference (they remain on disk as the authoritative working docs)
requirement.md
requirement_A2App.md
AGENTS.md
CLAUDE.md

# standalone documentation — kept on disk, not part of the distribution
docs/

# dogfooding proof run (self-validation of the framework lifecycle)
.a2app-proof/

# working diagrams — kept on disk, not part of the distribution
agent-app-user-journey.drawio

# internal audit notes — kept on disk, not part of the distribution
blocker_checklist.md

# skills copied into a harness by `agent-app skills --install <dir>` — generated
# from skills/ in this repo, so tracking them would commit the same six twice
# and let the copies drift from the source
.claude/skills/

# local machine setup helpers — machine-specific paths, not part of the distribution
setup-windows.ps1

# copied Claude Code session transcripts, for analysis only
_session/
