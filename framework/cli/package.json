{
  "name": "agent-app",
  "version": "0.1.0",
  "description": "The Agent App Framework CLI — `agent-app` builds and evolves Agent Apps; `a2app` operates them over the A2App protocol",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/CraftOS-dev/Agent-App.git", "directory": "framework/cli" },
  "homepage": "https://github.com/CraftOS-dev/Agent-App#readme",
  "bugs": "https://github.com/CraftOS-dev/Agent-App/issues",
  "type": "module",
  "bin": {
    "agent-app": "./bin/agent-app.js",
    "a2app": "./bin/a2app.js"
  },
  "main": "./dist/cli.js",
  "files": ["dist", "bin", "toolkits", "skills"],
  "engines": { "node": ">=20" },
  "dependencies": {
    "@a2app/rules": "workspace:*",
    "@a2app/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests\" && exit 0",
    "bundle-blueprints": "node scripts/bundle-blueprints.mjs",
    "bundle-skills": "node scripts/bundle-skills.mjs",
    "bundle": "node scripts/bundle-blueprints.mjs && node scripts/bundle-skills.mjs",
    "prepack": "node scripts/bundle-blueprints.mjs && node scripts/bundle-skills.mjs"
  }
}
