{
  "name": "@a2app/sdk",
  "version": "0.1.0",
  "description": "TypeScript client SDK for the A2App protocol — identity, describe, guarded writes, operations, tasks/events, whoami/context",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/CraftOS-dev/Agent-App.git", "directory": "sdks/typescript" },
  "homepage": "https://github.com/CraftOS-dev/Agent-App#readme",
  "bugs": "https://github.com/CraftOS-dev/Agent-App/issues",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "dependencies": {
    "@a2app/rules": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests\" && exit 0"
  }
}
