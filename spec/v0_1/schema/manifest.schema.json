{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentapp/manifest.json",
  "type": "object",
  "required": ["id", "name", "agentAppVersion", "adapterVersion", "authMode", "pipeline"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "agentAppVersion": { "type": "string" },
    "adapterVersion": { "type": "string" },
    "appVersion": { "type": "string" },
    "authMode": { "enum": ["none", "multi-user"] },
    "modificationLock": { "type": "boolean", "default": false },
    "capabilities": {
      "type": "object",
      "description": "declared agent capabilities this app may request (framework section 7 / A2APP-SPEC 6.6)",
      "properties": { "integrations": { "type": "array", "items": { "type": "string" } } }
    },
    "pipeline": {
      "type": "object",
      "required": ["install", "build", "start", "health"],
      "properties": {
        "install": { "type": "string" },
        "build": { "type": "string" },
        "start": { "type": "string" },
        "health": { "type": "string", "description": "URL path polled for readiness" }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "the app's launch port: the app binds it (an env override such as PORT may take precedence) and every operate command reaches the app there (framework section 5.5)"
    },
    "env": {
      "enum": ["dev", "live"],
      "description": "non-normative safe-evolve marker stamped by `a2app dev` (framework section 7.2)"
    }
  }
}
