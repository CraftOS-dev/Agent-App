# Credentials are runtime artifacts: never shipped, exported, or committed.
.agent-token
.principal
.superuser
.tunnel-secret
.lan-secret
*.secret

# The live database and adapter-owned state (the toolkit's lifecycle dataDir).
data/

# Framework runtime state: everything in .a2app/ (serve and dev records, logs,
# the gate pass, caches, backups) except the toolkit record and the ownership
# canon, which are part of the app.
.a2app/*
!.a2app/toolkit.json
!.a2app/system-hashes.json

# Dependencies the pipeline reinstalls: never shipped or committed.
node_modules/
