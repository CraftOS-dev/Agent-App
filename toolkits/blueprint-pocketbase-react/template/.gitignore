# Credentials are runtime artifacts: never shipped, exported, or committed.
.agent-token
.principal
.superuser

# The live database and adapter-owned state (the toolkit's lifecycle dataDir).
pb/pb_data/

# The PocketBase binary is fetched per machine, never committed.
pb/pocketbase
pb/pocketbase.exe

# Framework runtime state: serve records, logs, the dev instance, the live
# View snapshot, the gate pass, and backups.
.a2app/serve.json
.a2app/serve.log
.a2app/dev.json
.a2app/dev/
.a2app/public/
.a2app/gate-pass.json
.a2app/backups/

node_modules/

# The built View (vite build output of ui/) — rebuilt by the pipeline, never committed.
pb/pb_public/
