{
  "id": "REPLACED_AT_CREATE",
  "name": "PocketBase-React Agent App",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.1.0",
  "appVersion": "0.1.0",
  "authMode": "none",
  "modules": [
    {
      "name": "planning",
      "summary": "tasks and the work in front of you",
      "entities": [
        "tasks"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-serve.mjs --fetch && npm --prefix ui install",
    "build": "npm --prefix ui run build && node --check pb/pb_hooks/_a2app.pb.js",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
