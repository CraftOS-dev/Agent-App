# Credentials are runtime artifacts: never shipped, exported, or committed.
.agent-token
.principal
.superuser
.tunnel-secret
.lan-secret
*.secret

# The live database and adapter-owned state (the toolkit's lifecycle dataDir).
data/

# Framework runtime state: everything in .a2app/ (serve and dev records, logs,
# the gate pass, caches, backups) except the toolkit record and the ownership
# canon, which are part of the app.
.a2app/*
!.a2app/toolkit.json
!.a2app/system-hashes.json

node_modules/

# The built View (the Vite build output of ui/) — rebuilt by the pipeline,
# never committed, never hand-edited. ui/ is the source. Anchored to this
# directory: ui/public/ (tokens.css, ui.css) is source, not build output.
/public/

# Rails runtime artifacts (the minted secret lives in tmp/).
log/
tmp/
.bundle/
